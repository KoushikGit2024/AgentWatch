# CloudWatchV2 Configuration Template (Placeholders only - never commit real secrets)

# Server Binding
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Security
APP_PASSWORD=placeholder_app_password
JWT_SECRET=placeholder_jwt_secret_key_change_in_production
ALLOWED_ORIGINS=*

# MongoDB Local Persistence
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DATABASE=cloudwatch_v2
MONGODB_CONNECT_TIMEOUT_MS=3000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000

# Antigravity CDP & Integration
CDP_PORTS=9000,9001,9002,9003
CDP_DISCOVERY_INTERVAL_SEC=3
ANTIGRAVITY_INTEGRATION_MODE=environment_and_cdp

# Tailscale Integration
TAILSCALE_SERVE_ENABLED=true
TAILSCALE_LOCAL_PORT=8000
